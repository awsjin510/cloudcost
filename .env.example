# Copy to .env (git-ignored). Both the CLI and the web app load it via python-dotenv.

# GCP Cloud Billing Catalog API key. Optional: without it GCP falls back to the
# embedded price table. Create one at https://console.cloud.google.com/apis/credentials
# and enable "Cloud Billing API" on the project.
GCP_API_KEY=

# Anthropic API key for the AI recommendation section. Optional.
ANTHROPIC_API_KEY=
