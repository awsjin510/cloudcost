{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs"
      ],
      "port": 4173
    },
    {
      "name": "web",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "cloudcost.web.app:app",
        "--port",
        "8123"
      ],
      "port": 8123
    },
    {
      "name": "web-tokens",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANTHROPIC_API_KEY=dummy-local-test",
        "ANTHROPIC_BASE_URL=http://127.0.0.1:9",
        ".venv/bin/python",
        "-m",
        "uvicorn",
        "cloudcost.web.app:app",
        "--port",
        "8124"
      ],
      "port": 8124
    }
  ]
}